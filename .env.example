# Скопируй в .env и заполни. НЕ коммить этот файл.
BOT_TOKEN=

# Публичный адрес Mini App:
#  • если раздаём web/index.html с Render → https://<service>.onrender.com
#  • если с GitHub Pages → https://<user>.github.io/<repo>/
WEBAPP_URL=http://localhost:8000

# нужен только если Mini App на GitHub Pages, а API на Render
PUBLIC_URL=http://localhost:8000

# локальные файлы; на Render они лежат на постоянном диске
USERS_FILE=./users.json
PNL_CACHE_FILE=./pnl_cache.json
DATA_DIR=.
